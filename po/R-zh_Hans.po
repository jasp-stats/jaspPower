msgid ""
"The design used evidence thresholds of BF₁₀ ≥ %1$s for H₁ and BF₀₁ ≥ %2$s "
"for H₀ (equivalently, BF₁₀ ≤ %3$s)."
msgstr "该设计对 H₁ 使用证据阈值 BF₁₀ ≥ %1$s，对 H₀ 使用 BF₀₁ ≥ %2$s（等价地，BF₁₀ ≤ %3$s）。"

msgid "The design evaluated %1$s."
msgstr "该设计评估了 %1$s。"

msgid ""
"The design selected %1$s to target conclusive evidence probabilities of %2$s "
"under H₁ and %3$s under H₀."
msgstr "该设计选择 %1$s 以实现在 H₁ 下确定性证据概率为 %2$s、在 H₀ 下为 %3$s 的目标。"

msgid ""
"The design selected %1$s for the H₁ planning target and %2$s for the H₀ "
"planning target, with target conclusive evidence probabilities of %3$s and "
"%4$s, respectively."
msgstr "该设计为 H₁ 规划目标选择 %1$s，为 H₀ 规划目标选择 %2$s，目标确定性证据概率分别为 %3$s 和 %4$s。"

msgid ""
"The achieved probability of conclusive evidence was %1$s under H₁ and %2$s "
"under H₀; the probability of misleading evidence was %3$s under H₁ and %4$s "
"under H₀."
msgstr "H₁ 下确定性证据的达成概率为 %1$s，H₀ 下为 %2$s；误导性证据的概率在 H₁ 下为 %3$s，在 H₀ 下为 %4$s。"

msgid ""
"The design analysis used JASP with the jaspPower module version %1$s and the "
