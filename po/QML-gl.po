msgid "Independent Samples T-Test"
msgstr "Proba T para mostras independentes"

msgctxt "BayesFactorSequentialDesign|"
msgid "Paired Samples T-Test"
msgstr "Proba T para mostras emparelladas"

msgctxt "BayesFactorSequentialDesign|"
