#, qt-format
msgctxt "GroupSequentialBoundaryControls|"
msgid ""
"γ parameter for Hwang-Shih-DeCani spending; allowable range is [%1, %2]. "
"Default is %3 for the upper boundary and %4 for the lower boundary."
msgstr ""
"Parámetro γ para a asignación de Hwang-Shih-DeCani; o rango admisible é [%1, "
"%2]. O predeterminado é %3 para a fronteira superior, e %4 para a fronteira "
"inferior."

#, qt-format
msgctxt "GroupSequentialBoundaryControls|"
msgid ""
"ρ parameter for Kim-DeMets power spending; allowable range is (%1, %2]. "
"Default is %3."
msgstr ""
"Parámetro ρ para a asignación de potencia de Kim-DeMets; o rango admisible é "
"(%1, %2]. O predeterminado é %3."

#, qt-format
msgctxt "GroupSequentialBoundaryControls|"
msgid ""
"Δ parameter for the Wang-Tsiatis boundary family. Default is %1; Δ = 0 gives "
"an O'Brien-Fleming-like boundary and Δ = 0.5 gives a Pocock-like boundary."
msgstr ""
"Parámetro Δ para a familia de límites de Wang-Tsiatis. O predeterminado é "
"%1; Δ = 0 indica unha fronteira como a de O'Brien-Fleming, e Δ = 0.5 indica "
"unha fronteira como a de Pocock."

