msgstr "SD 2"

msgid "Mean difference"
msgstr "فرق المتوسطين"

msgid "SD difference"
msgstr "الانحراف المعياري للفروق"

msgid "Cohen's d"
msgstr "معامل d لكوهين"

msgid "Failures"
msgstr "حالات الإخفاق"

msgid "The total number of successes and failures must be at least 1."
msgstr "يجب ألا يقل مجموع حالات النجاح والإخفاق عن 1."

msgid "No dataset is available for column input."
msgstr "لا تتوفر مجموعة بيانات لاستخدام أعمدتها كمدخلات."

msgid "Column data"
msgstr "بيانات العمود"

msgid "The selected variable contains no observed values."
msgstr "لا يتضمن المتغير المحدد قيمًا مشاهدة."

msgid "Dependent variable"
msgstr "المتغير التابع"

msgid "Grouping variable"
msgstr "متغير التجميع"

msgid "The grouping variable must contain exactly two observed groups."
msgstr "يجب أن يتضمن متغير التجميع مجموعتين مشاهدتين بالضبط."

msgid "%1$s by %2$s"
msgstr "%1$s حسب %2$s"

msgid "First variable"
msgstr "المتغير الأول"

msgid "Second variable"
msgstr "المتغير الثاني"

msgid "%1$s - %2$s"
msgstr "%1$s - %2$s"

msgid "Variable pair must contain two different variables."
msgstr "يجب أن يحتوي زوج المتغيرات على متغيرين مختلفين."

msgid "Variable pair must be selected."
msgstr "يجب تحديد زوج من المتغيرات."

msgid "Pooled SD"
msgstr "الانحراف المعياري المجمّع"

msgid "Observed Bayes factor is not finite."
msgstr "قيمة عامل بايز المشاهَد ليست منتهية."

msgid "Stop for H₁"
msgstr "التوقف لصالح H₁"

msgid "BF supports H₁"
msgstr "عامل بايز يدعم H₁"

msgid "Stop for H₀"
msgstr "التوقف لصالح H₀"

msgid "BF supports H₀"
msgstr "عامل بايز يدعم H₀"

msgid "Continue"
msgstr "متابعة"

msgid "Inconclusive"
msgstr "غير حاسم"

msgid "%1$s must be selected."
msgstr "يجب تحديد %1$s."

msgid "%1$s was not found in the dataset."
msgstr "لم يُعثر على %1$s في مجموعة البيانات."

msgid "%1$s contains no observed values."
msgstr "لا يحتوي %1$s على قيم مشاهدة."

msgid "%1$s must be numeric."
msgstr "يجب أن يكون %1$s عدديًا."

msgid "%1$s contains infinite values."
msgstr "يحتوي %1$s على قيم لانهائية."

msgid "%1$s must be a finite number."
msgstr "يجب أن يكون %1$s عددًا منتهيًا."

msgid "%1$s must be an integer of at least %2$s."
msgstr "يجب أن يكون %1$s عددًا صحيحًا لا يقل عن %2$s."

msgid "%1$s must be at least %2$s."
msgstr "يجب ألا يقل %1$s عن %2$s."

msgid "%1$s must be positive."
msgstr "يجب أن يكون %1$s موجبًا."

msgid "N₁ = %1$s and N₂ = %2$s"
msgstr "N₁ = %1$s وN₂ = %2$s"

msgid "N = %1$s"
msgstr "N = %1$s"

msgid "Report"
msgstr "التقرير"

msgid "The report could not be generated because the Bayes factor design could not be completed with the current settings."
msgstr ""
"تعذّر توليد التقرير لأن تصميم عامل بايز لم يتسنّ استكماله مع الإعدادات الحالية."

msgid "The report could not be generated because the Bayes factor design could not be completed for all design priors."
msgstr ""
"تعذر إنشاء التقرير لعدم اكتمال تصميم عامل بايز لجميع التوزيعات القبلية "
"للتصميم."

msgid "fixed-sample"
msgstr "ذو حجم عينة ثابت"

msgid "Unable to generate report: %1$s"
msgstr "تعذّر إنشاء التقرير: %1$s"

msgid "A %1$s Bayes factor design %2$s a %3$s %4$s %5$s."
msgstr "جرى %2$s تصميم %1$s قائم على عامل بايز للاختبار الآتي %4$s، %3$s %5$s."

msgid "general z-test (with UISD = %1$s)"
msgstr "اختبار z العام (مع UISD = %1$s)"

msgid "specified"
msgstr "تحديد"

msgid "evaluated"
msgstr "تقييم"

msgid "one-sided"
msgstr "أحادي الطرف"

msgid "two-sided"
msgstr "ثنائي الطرف"

msgid "(H₁: %1$s %2$s %3$s)"
msgstr "(H₁: %1$s %2$s %3$s)"

msgid "The analysis prior for H₀ %1$s, and the analysis prior for H₁ %2$s."
msgstr ""
"التوزيع القبلي للتحليل تحت H₀ %1$s، والتوزيع القبلي للتحليل تحت H₁ %2$s."

msgid "The design prior for H₀ %1$s, and the design prior for H₁ %2$s."
msgstr ""
"التوزيع القبلي للتصميم تحت H₀ %1$s، والتوزيع القبلي للتصميم تحت H₁ %2$s."

msgid "used %1$s, truncated to %2$s"
msgstr "استُخدم %1$s، مقتطعًا إلى %2$s"

msgid "%1$s ~ Cauchy(location = %2$s, scale = %3$s)"
msgstr "%1$s ~ Cauchy(location = %2$s, scale = %3$s)"

msgid "%1$s ~ Student-t(location = %2$s, scale = %3$s, df = %4$s)"
msgstr "%1$s ~ Student-t(location = %2$s, scale = %3$s, df = %4$s)"

msgid "%1$s ~ Normal-moment(spread = %2$s, modes = ±%3$s)"
msgstr "%1$s ~ Normal-moment(spread = %2$s, modes = ±%3$s)"

msgid "used %1$s"
msgstr "استُخدم %1$s"

msgid "%1$s ~ Normal(mean = %2$s, SD = %3$s)"
msgstr "%1$s ~ Normal(mean = %2$s, SD = %3$s)"

msgid "used %1$s ~ Normal(mean = %2$s, SD = %3$s)"
msgstr "استُخدم %1$s ~ Normal(mean = %2$s, SD = %3$s)"

msgid "used %1$s, truncated to %2$s ≤ p ≤ %3$s"
msgstr "استُخدم %1$s، مقتطعًا إلى %2$s ≤ p ≤ %3$s"

msgid "placed all mass at %1$s = %2$s"
msgstr "وضع الكتلة الاحتمالية كلها عند %1$s = %2$s"

msgid "%1$s ~ Beta(a = %2$s, b = %3$s)"
msgstr "%1$s ~ Beta(a = %2$s, b = %3$s)"

msgid "%1$s > %2$s"
msgstr "%1$s > %2$s"

msgid "%1$s ≤ %2$s"
msgstr "%1$s ≤ %2$s"

msgid "%1$s < %2$s"
msgstr "%1$s < %2$s"

msgid "%1$s ≥ %2$s"
msgstr "%1$s ≥ %2$s"

msgid "The design used evidence thresholds of BF₁₀ ≥ %1$s for H₁ and BF₀₁ ≥ %2$s for H₀ (equivalently, BF₁₀ ≤ %3$s)."
msgstr ""
"استخدم التصميم عتبات دليل BF₁₀ ≥ %1$s لصالح H₁ وBF₀₁ ≥ %2$s لصالح H₀ (أي BF₁"
"₀ ≤ %3$s)."

msgid "The design evaluated %1$s."
msgstr "قيّم التصميم %1$s."

msgid "The design selected %1$s to target conclusive evidence probabilities of %2$s under H₁ and %3$s under H₀."
msgstr ""
"اختار التصميم %1$s لاستهداف احتمال دليل حاسم قدره %2$s تحت H₁ و%3$s تحت H₀."

msgid "The design selected %1$s for the H₁ planning target and %2$s for the H₀ planning target, with target conclusive evidence probabilities of %3$s and %4$s, respectively."
msgstr ""
"اختار التصميم %1$s لهدف التخطيط تحت H₁ و%2$s لهدف التخطيط تحت H₀، مع "
"احتمالين مستهدفين للدليل الحاسم مقدارهما %3$s و%4$s على الترتيب."

msgid "The achieved probability of conclusive evidence was %1$s under H₁ and %2$s under H₀; the probability of misleading evidence was %3$s under H₁ and %4$s under H₀."
msgstr ""
"بلغ الاحتمال المتحقق للدليل الحاسم %1$s تحت H₁ و%2$s تحت H₀؛ وبلغ احتمال "
"الدليل المضلل %3$s تحت H₁ و%4$s تحت H₀."

msgid "The design analysis used JASP with the jaspPower module version %1$s and the bfpwr R package version %2$s."
msgstr ""
"استخدم تحليل التصميم JASP مع وحدة jaspPower بالإصدار %1$s وحزمة R المسماة "
"bfpwr بالإصدار %2$s."

msgid "unknown"
msgstr "مجهول"

msgid "not available"
msgstr "غير متاح"

msgid "1/%1$s"
msgstr "1/%1$s"

msgid "R Code"
msgstr "شيفرة R"

msgid "Unable to generate R code: %1$s"
msgstr "تعذّر إنشاء شيفرة R: %1$s"

msgid "Decision Probabilities by Sample Size"
msgstr "احتمالات القرار حسب حجم العينة"

msgid "Unable to compute conclusive evidence and misleading evidence curves: %1$s"
msgstr "تعذر حساب منحنيات الدليل الحاسم والدليل المضلل: %1$s"

msgid "Sample size (group 1)"
msgstr "حجم العينة (المجموعة 1)"

msgid "Sample size"
msgstr "حجم العينة"

msgid "Probability"
msgstr "الاحتمال"

msgid "Outcome"
msgstr "النتيجة"

msgid "Decision Probabilities by Proportion"
msgstr "احتمالات القرار حسب النسبة"

msgid "Decision Probabilities by Effect Size"
msgstr "احتمالات القرار حسب حجم الأثر"

msgid "This plot shows how the probabilities of conclusive and misleading evidence change with sample size while priors and thresholds are held fixed. Use it to see how quickly the planned design becomes informative."
msgstr ""
"يوضح هذا الرسم تغير احتمالي الدليل الحاسم والمضلل مع حجم العينة، مع تثبيت "
"التوزيعات القبلية والعتبات. استخدمه لمعرفة مدى سرعة توفير التصميم المخطط "
"معلومات مفيدة."

msgid "This plot shows how the probabilities of conclusive and misleading evidence change across possible design proportions. Use it as a sensitivity check for the assumed proportion under the design prior."
msgstr ""
"يوضح هذا الرسم تغير احتمالي الدليل الحاسم والمضلل عبر النسب الممكنة للتصميم. "
"استخدمه لفحص الحساسية للنسبة المفترضة في التوزيع القبلي للتصميم."

msgid "This plot shows how the probabilities of conclusive and misleading evidence change across possible design-prior effect sizes. Use it as a sensitivity check for the assumed effect size."
msgstr ""
"يوضح هذا الرسم تغير احتمالي الدليل الحاسم والمضلل عبر أحجام الأثر الممكنة "
"للتوزيع القبلي للتصميم. استخدمه لفحص الحساسية لحجم الأثر المفترض."

