msgstr "بدأ التصميم عند n_min = %1$s، واستخدم %2$s، وتوقف عند n_max = %3$s."

msgid "The design started at n_min,1 = %1$s and n_min,2 = %2$s, used %3$s, and found maximum sample sizes n_max,1 = %4$s and n_max,2 = %5$s under H₁ and n_max,1 = %6$s and n_max,2 = %7$s under H₀."
msgstr ""
