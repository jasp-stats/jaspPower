msgid "Power Curve by N"
msgstr "منحنى القوة الإحصائية حسب N"

msgid "Power Demonstration"
msgstr "عرض توضيحي للقوة الإحصائية"

msgid "Synthetic Dataset"
msgstr "مجموعة بيانات اصطناعية"

msgid "Characteristics"
msgstr "الخصائص"

