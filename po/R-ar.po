msgstr "تعذر حساب مخطط احتمالات تجاوز الحدود: %1$s"

msgid "Under"
msgstr "تحت"

msgid "Upper (non-binding)"
msgstr "الحد العلوي (غير ملزم)"

msgid "Effect size can't be 0."
msgstr "حجم الأثر لا يمكن أن يكون 0."

msgid "The comparison proportion can't be equal to the hypothesized proportion with a 'Two-sided' alternative hypothesis."
msgstr ""
"لا يمكن أن تساوي نسبة المقارنة النسبة المفترضة عند اختيار فرضية بديلة «ثنائية "
"الطرف»."

msgid "The comparison proportion has to be less than the hypothesized proportion with an alternative hypothesis of 'Less'."
msgstr ""
"يجب أن تكون نسبة المقارنة أقل من النسبة المفترضة عند اختيار الفرضية البديلة «"
"أقل»."

msgid "The comparison proportion has to be greater than the hypothesized proportion with an alternative hypothesis of 'Greater'."
msgstr ""
"يجب أن تكون نسبة المقارنة أكبر من النسبة المفترضة عند اختيار الفرضية البديلة "
"«أكبر»."

msgid "Invalid alternative."
msgstr "الفرضية البديلة غير صالحة."

msgid "The comparison proportion can't be equal to the baseline proportion with a 'Two-sided' alternative hypothesis."
msgstr ""
"لا يمكن أن تساوي نسبة المقارنة نسبة خط الأساس عند اختيار فرضية بديلة «ثنائية "
"الطرف»."

msgid "The comparison proportion has to be less than the baseline proportion with an alternative hypothesis of 'Less'."
msgstr ""
"يجب أن تكون نسبة المقارنة أقل من نسبة خط الأساس عند اختيار الفرضية البديلة «"
"أقل»."

msgid "The comparison proportion has to be greater than the baseline proportion with an alternative hypothesis of 'Greater'."
msgstr ""
"يجب أن تكون نسبة المقارنة أكبر من نسبة خط الأساس عند اختيار الفرضية البديلة «"
"أكبر»."

msgid "The variance ratio can't be 1 with a 'Two-sided' alternative hypothesis."
msgstr "نسبة التباين لا يمكن أن تكون 1 مع فرضية بديلة \"ثنائية الجانب\"."

msgid "The variance ratio has to be less than 1 with an alternative hypothesis 'Less'."
msgstr "يجب أن تكون نسبة التباين أقل من 1 عند اختيار الفرضية البديلة «أقل»."

msgid "The variance ratio has to be greater than 1 with an alternative hypothesis of 'Greater'."
msgstr "يجب أن تكون نسبة التباين أكبر من 1 عند اختيار الفرضية البديلة «أكبر»."

msgid "BF₁₀ ≥ %1$s"
msgstr "BF₁₀ ≥ %1$s"

msgid "BF₀₁ ≥ %1$s"
msgstr "BF₀₁ ≥ %1$s"

msgid "Invalid target '%1$s'."
msgstr "الهدف '%1$s' غير صالح."

msgid "Point proportion"
msgstr "قيمة نقطية للنسبة"

msgid "a = %1$s, b = %2$s, lower = %3$s, upper = %4$s"
msgstr "a = %1$s، b = %2$s، الحد السفلي = %3$s، الحد العلوي = %4$s"

msgid "Bayes Factor Evidence"
msgstr "دليل عامل بايز"

