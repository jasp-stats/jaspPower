msgstr "الخيار '%1$s' مفقود."

msgid "Option '%1$s' must contain one finite numeric value."
msgstr "يجب أن يحتوي الخيار '%1$s' على قيمة عددية واحدة منتهية."

msgid "Summary statistics"
msgstr "الإحصاءات الملخصة"

msgid "Estimate"
msgstr "التقدير"

