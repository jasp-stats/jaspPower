msgstr "حالات النجاح"

msgid "Trials"
msgstr "المحاولات"

msgid "Proportion"
msgstr "النسبة"

msgid "Mean Difference"
msgstr "فرق المتوسطين"

msgid "SD Difference"
msgstr "الانحراف المعياري للفروق"

msgid "SE"
msgstr "الخطأ المعياري (SE)"

